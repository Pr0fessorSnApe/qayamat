# QAYAMAT — copy to .env and fill in your keys
# cp .env.example .env   (Linux/macOS)
# copy .env.example .env   (Windows)

# ── AI (at least one recommended for finding triage) ──────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GITHUB_TOKEN=

# ── OSINT / threat intelligence ───────────────────────────────────────────────
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
OTX_API_KEY=
SECURITYTRAILS_API_KEY=
URLSCAN_API_KEY=
VIRUSTOTAL_API_KEY=

# ── Bug bounty platform submission (your account only) ───────────────────────
HACKERONE_API_IDENTIFIER=
HACKERONE_API_TOKEN=
BUGCROWD_API_TOKEN=

# ── Notifications (continuous monitor alerts) ───────────────────────────────────
NOTIFY_WEBHOOK_URLS=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
